# Base URL of the UnderPass API (must include the /api/v1 path suffix).
# Required for any non-dev build (npm run build) — the build fails fast at
# startup if this is unset. Optional in dev (npm run dev), which falls back
# to the local backend and logs a warning when unset.
VITE_API_BASE_URL=http://localhost:8000/api/v1
